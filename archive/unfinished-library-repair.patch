+def reconcile_limits(proposed,checked,effective_total):
+    """Only lower a stale AUTO memory ceiling; never relax a fresh hard bound.
+
+    Available RAM is sampled in two processes. Comparing their maximum budgets
+    for exact equality rejects a valid plan after even a 1 MiB decrease. The
+    worker receives the smaller, freshly checked limit. Manual profile ceilings,
+    CPU/process limits, host reserve and actual kernel qualification remain hard.
+    """
+    mib=1024*1024;minimum={'memory_bytes':256*mib,'tasks':16,'cpu_threads':1,'cpu_quota_percent':1}
+    def reject(field,reason):
+        error=InferenceError(reason+': '+field,code='RESOURCE_LIMIT',stage='resource-protection')
+        error.resources={'requested_limits':{k:proposed.get(k) if type(proposed.get(k)) is int else 'invalid type' for k in minimum},'fresh_limits':{k:checked[k] for k in minimum}}
+        raise error
+    for field,lower in minimum.items():
+        if type(proposed.get(field)) is not int or proposed[field]<lower:reject(field,'Invalid bounded runtime limit')
+        if field!='memory_bytes' and proposed[field]>checked[field]:reject(field,'Requested runtime limit exceeds freshly checked allowance')
+    if proposed['memory_bytes']>effective_total-checked['host_reserve_bytes']:reject('memory_bytes','Requested memory exceeds the physical/ancestor reserve boundary')
+    applied=dict(proposed)
+    if proposed['memory_bytes']>checked['memory_bytes']:
+        if proposed.get('selection')!='auto':reject('memory_bytes','Requested manual limit exceeds freshly checked host/profile allowance')
+        estimates=[p['estimate']['estimated_bytes'] for p in checked['participants']]
+        for p in proposed.get('participants',[]):
+            value=p.get('estimate',{}).get('estimated_bytes')
+            if type(value) is not int or value<=0:reject('memory_bytes','Invalid measured-model requirement')
+            estimates.append(value)
+        if any(value>checked['memory_bytes'] for value in estimates):reject('memory_bytes','Fresh allowance cannot contain the selected AUTO model requirement')
+        applied['memory_bytes']=checked['memory_bytes']
+    return applied
